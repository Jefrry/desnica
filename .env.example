# Nuxt
NUXT_STRAPI_URL=http://localhost:1337
NUXT_PUBLIC_STRAPI_URL=http://localhost:1337
NUXT_PUBLIC_PREVIEW_MODE=false
WEB_PORT=3000

# Strapi
HOST=0.0.0.0
PORT=1337
CMS_PORT=1337
PUBLIC_URL=http://localhost:1337
APP_KEYS=replace-with-four-long-random-values-separated-by-commas
API_TOKEN_SALT=replace-with-a-long-random-value
ADMIN_JWT_SECRET=replace-with-a-long-random-value
TRANSFER_TOKEN_SALT=replace-with-a-long-random-value
JWT_SECRET=replace-with-a-long-random-value
ENCRYPTION_KEY=replace-with-a-long-random-value
IS_PROXIED=false

# PostgreSQL
DATABASE_CLIENT=postgres
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=strapi
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=replace-with-a-strong-password
DATABASE_SCHEMA=public
DATABASE_SSL=false
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT=60000
