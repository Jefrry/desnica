# Nuxt
NUXT_STRAPI_URL=http://localhost:1337
NUXT_PUBLIC_STRAPI_URL=http://localhost:1337
# Indexing is blocked unless explicitly enabled (independent of content).
# Compose maps WEB_INDEXING_ALLOWED to NUXT_INDEXING_ALLOWED.
NUXT_INDEXING_ALLOWED=false
WEB_INDEXING_ALLOWED=false
WEB_PORT=3000

# Strapi
# V8 old-space limit during image build only; small servers also need swap.
CMS_BUILD_HEAP_MB=2048
HOST=0.0.0.0
PORT=1337
CMS_PORT=1337
PUBLIC_URL=http://localhost:1337
APP_KEYS=replace-with-four-long-random-values-separated-by-commas
API_TOKEN_SALT=replace-with-a-long-random-value
ADMIN_JWT_SECRET=replace-with-a-long-random-value
TRANSFER_TOKEN_SALT=replace-with-a-long-random-value
JWT_SECRET=replace-with-a-long-random-value
ENCRYPTION_KEY=replace-with-a-long-random-value
IS_PROXIED=false
CMS_INDEXING_ALLOWED=false
INDEXING_ALLOWED=false

# PostgreSQL
DATABASE_CLIENT=postgres
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=strapi
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=replace-with-a-strong-password
DATABASE_SCHEMA=public
DATABASE_SSL=false
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT=60000
